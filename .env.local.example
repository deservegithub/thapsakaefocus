# ===== Supabase =====
# คัดลอกไฟล์นี้เป็น .env.local แล้วเติมค่าจริงจาก Supabase Dashboard
#   Project Settings > API
# (.env.local ถูก gitignore ไว้แล้ว — อย่า commit ค่าจริง)

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# service_role key ใช้เฉพาะฝั่งเซิร์ฟเวอร์ (อย่าใส่ NEXT_PUBLIC_) — ใช้ตอนทำงาน admin/seed ภายหลัง
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===== LINE Login (Custom OIDC) =====
# slug ของ Custom OIDC provider ที่ตั้งไว้ใน Supabase Dashboard (Authentication > Providers)
# ต้องขึ้นต้นด้วย custom: — ค่าเริ่มต้นในโค้ดคือ custom:line (ตั้ง env นี้ถ้าใช้ชื่ออื่น)
# NEXT_PUBLIC_LINE_OIDC_PROVIDER=custom:line
# แสดงปุ่ม LINE ในหน้า login เฉพาะเมื่อตั้งค่า OIDC เสร็จแล้ว (กันกดแล้ว error)
# NEXT_PUBLIC_LINE_ENABLED=true

# ===== Plausible Analytics =====
# ใส่ domain แล้ว script จึงจะโหลด (ไม่ใส่ = ไม่เก็บสถิติ)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=thapsakaefocus.com
# (self-host เท่านั้น) NEXT_PUBLIC_PLAUSIBLE_SRC=https://your-instance/js/script.js

# ===== Sentry =====
# ใส่ DSN แล้วจึงจะเริ่มส่ง error (ไม่ใส่ = inert) — ทำงานเฉพาะ production build
# NEXT_PUBLIC_SENTRY_DSN=https://xxxx@oXXXX.ingest.sentry.io/XXXX
# SENTRY_DSN=https://xxxx@oXXXX.ingest.sentry.io/XXXX
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_TRACES_SAMPLE_RATE=0.1
# สำหรับอัปโหลด source map ตอน build (ทางเลือก):
# SENTRY_ORG=your-org
# SENTRY_PROJECT=your-project
# SENTRY_AUTH_TOKEN=your-auth-token
