# ===== Supabase =====
# คัดลอกไฟล์นี้เป็น .env.local แล้วเติมค่าจริงจาก Supabase Dashboard
#   Project Settings > API
# (.env.local ถูก gitignore ไว้แล้ว — อย่า commit ค่าจริง)

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# service_role key ใช้เฉพาะฝั่งเซิร์ฟเวอร์ (อย่าใส่ NEXT_PUBLIC_) — ใช้ตอนทำงาน admin/seed ภายหลัง
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
